<script>
  document.addEventListener('DOMContentLoaded', function () {
    const btn = document.querySelector('.main-header--mobile-btn');
    const inner = document.querySelector('.menu-mobile__inner');

    if (btn) {
      btn.addEventListener('click', function () {
        document.body.classList.toggle('is-open-menu-mobile');
        document.documentElement.classList.toggle('is-open-menu-mobile');
      });
    }

    document.addEventListener('click', function (e) {
      const isMenuOpen = document.body.classList.contains('is-open-menu-mobile');

      if (!isMenuOpen) return;

      const clickedInsideMenu = inner && inner.contains(e.target);
      const clickedButton = btn && btn.contains(e.target);

      if (!clickedInsideMenu && !clickedButton) {
        document.body.classList.remove('is-open-menu-mobile');
        document.documentElement.classList.remove('is-open-menu-mobile');
      }
    });
  });
  document.addEventListener('DOMContentLoaded', () => {
    const items = document.querySelectorAll('.menu-mobile__nav-list-item.has-dropdown');

    items.forEach((item) => {
      item.addEventListener('click', () => {
        items.forEach((el) => {
          if (el !== item) {
            el.classList.remove('is-dropdown-open');

            const inner = el.querySelector('.menu-mobile__nav-list-item-dropdown-2');
            if (inner) {
              inner.classList.remove('is-dropdown-open');
            }
          }
        });

        item.classList.toggle('is-dropdown-open');

        const innerDropdown = item.querySelector('.menu-mobile__nav-list-item-dropdown-2');
        if (innerDropdown) {
          innerDropdown.classList.toggle('is-dropdown-open');
        }
      });
    });
  });

  document.addEventListener('DOMContentLoaded', () => {
    const header = document.querySelector('.global-header .main-navigation');
    let lastScrollY = window.scrollY;
    const threshold = 10;

    window.addEventListener('scroll', () => {
      const currentScrollY = window.scrollY;

      if (currentScrollY <= 0) {
        header.classList.remove('is-hidden');
        lastScrollY = currentScrollY;
        return;
      }

      if (Math.abs(currentScrollY - lastScrollY) < threshold) {
        return;
      }

      if (currentScrollY > lastScrollY && currentScrollY > 50) {
        header.classList.add('is-hidden');
      } else {
        header.classList.remove('is-hidden');
      }

      lastScrollY = currentScrollY;
    });
  });

  document.addEventListener('DOMContentLoaded', () => {
    const config = [
      {
        button: '.nav-links-solutions-2 .solutions-link-2',
        target: '.drop-wrap-solution',
      },
      {
        button: '.nav-links-works-2 .works-link-2',
        target: '.drop-wrap-works',
      },
      {
        button: '.nav-links-resource .resources-link-2',
        target: '.drop-wrap-resources',
      },
      {
        button: '.nav-links-about-2 .about-link-2',
        target: '.drop-wrap-about',
      },
    ];

    const extraDropdowns = document.querySelectorAll('.dropdown-solutions-2, .dropdown-box-works-2, .dropdown-box-abt-2');

    const items = config.map((item) => ({
      btn: document.querySelector(item.button),
      target: document.querySelector(item.target),
    }));

    const closeAll = () => {
      items.forEach(({ btn, target }) => {
        if (btn) btn.classList.remove('active');
        if (target) target.classList.remove('active');
      });

      extraDropdowns.forEach((el) => {
        el.classList.remove('active');
      });
    };

    items.forEach(({ btn, target }) => {
      if (!btn || !target) return;

      btn.addEventListener('click', (e) => {
        e.stopPropagation();

        const isActive = btn.classList.contains('active');

        closeAll();

        if (!isActive) {
          btn.classList.add('active');
          target.classList.add('active');
        }
      });

      target.addEventListener('click', (e) => {
        e.stopPropagation();
      });
    });

    document.addEventListener('click', closeAll);
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const searchBar = document.querySelector('.main-search-bar');
    const searchInput = searchBar ? searchBar.querySelector('input') : null;
    const clearBtn = document.querySelector('.search-clear-btn');

    if (!searchBar || !searchInput || !clearBtn) return;

    // Hide clear button initially
    clearBtn.style.display = 'none';

    // Activate search
    function activateSearch() {
      searchBar.classList.add('is-visible');
      clearBtn.style.display = 'block';
    }

    searchInput.addEventListener('focus', activateSearch);
    searchBar.addEventListener('click', activateSearch);

    // Click outside → remove is-visible + hide clear button
    document.addEventListener('click', (e) => {
      if (!searchBar.contains(e.target)) {
        searchBar.classList.remove('is-visible');
        clearBtn.style.display = 'none';
      }
    });

    // Clear button
    clearBtn.addEventListener('click', (e) => {
      e.stopPropagation(); // prevent closing
      searchInput.value = '';
      searchInput.focus(); // keep active
    });
  });
</script></div></section><div class="utility-page-wrap"><div class="utility-page-content"><div class="div-block-109"><h1>404</h1><div class="text-block-38">Seems like nothing is here.</div></div><div class="div-btnbox"><a href="/old-home" class="butt-white-purple bg-color-transparent tp-14 w-button">Back to homepage</a></div></div></div><section id="outro" class="section"><section id="outro" class="section pd-80 bg-blue bg-dark-blue"><div class="w-layout-blockcontainer container w-container"><div class="step-desktop"><div class="w-layout-grid grid-3col"><div class="grid-3col-left"><p class="p-lightblue opacity text-light">&gt; visibility...enabled</p></div><div class="grid-3col-lmid"><h4 class="new-title-demo">Step into the future of supply chain visibility</h4><div class="btn-top-32"><a href="/contact" class="butt-white-purple bg-color-white br-6 w-button">Request Demo</a></div></div><div class="grid-3col-right"><p class="p-lightblue opacity text-light">Transform</p></div></div><div class="imgbox-center-home"><img width="1040" loading="lazy" alt="" src="https://cdn.prod.website-files.com/69705b4bd697a364360a4fd0/6a27f196a84a89778de31e4d_Mask%20group%20(10).avif" sizes="(max-width: 767px) 100vw, (max-width: 991px) 728px, 940px" srcset="https://cdn.prod.website-files.com/69705b4bd697a364360a4fd0/6a27f196a84a89778de31e4d_Mask%20group%20(10)-p-500.avif 500w, https://cdn.prod.website-files.com/69705b4bd697a364360a4fd0/6a27f196a84a89778de31e4d_Mask%20group%20(10)-p-800.avif 800w, https://cdn.prod.website-files.com/69705b4bd697a364360a4fd0/6a27f196a84a89778de31e4d_Mask%20group%20(10)-p-1080.avif 1080w, https://cdn.prod.website-files.com/69705b4bd697a364360a4fd0/6a27f196a84a89778de31e4d_Mask%20group%20(10)-p-1600.avif 1600w, https://cdn.prod.website-files.com/69705b4bd697a364360a4fd0/6a27f196a84a89778de31e4d_Mask%20group%20(10)-p-2000.avif 2000w, https://cdn.prod.website-files.com/69705b4bd697a364360a4fd0/6a27f196a84a89778de31e4d_Mask%20group%20(10).avif 2076w" class="imag