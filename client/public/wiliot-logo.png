height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->

<script src="https://cdnjs.cloudflare.com/ajax/libs/Swiper/11.0.5/swiper-bundle.min.js" integrity="sha512-Ysw1DcK1P+uYLqprEAzNQJP+J4hTx4t/3X2nbVwszao8wD+9afLjBQYjz7Uk4ADP+Er++mJoScI42ueGtQOzEA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

<script defer>
document.addEventListener('DOMContentLoaded', function () {

  /* =========================
     MENU TOGGLE
  ========================= */
  const menuTrigger = document.querySelector('#menu-trigger');
  const closeBtn = document.querySelector('.close-transparent');
  const bgOverlay = document.querySelector('.nav-mobile-wrapper .bg-dark');

  function openMenu() {
    document.documentElement.classList.add('menu-open');
    document.body.classList.add('menu-open');
  }

  function closeMenu() {
    document.documentElement.classList.remove('menu-open');
    document.body.classList.remove('menu-open');
  }

  menuTrigger?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  bgOverlay?.addEventListener('click', closeMenu);


  /* =========================
     SHARE LINKS
  ========================= */
  const url = encodeURIComponent(window.location.href);
  const title = encodeURIComponent(document.title);

  document.querySelector('.share-facebook')
    ?.setAttribute('href', `https://www.facebook.com/sharer/sharer.php?u=${url}`);

  document.querySelector('.share-twitter')
    ?.setAttribute('href', `https://twitter.com/intent/tweet?url=${url}&text=${title}`);

  document.querySelector('.share-linkedin')
    ?.setAttribute('href', `https://www.linkedin.com/sharing/share-offsite/?url=${url}`);

  document.querySelector('.share-email')
    ?.setAttribute('href', `mailto:?subject=${title}&body=${url}`);


  /* =========================
     NAV SCROLL (OPTIMIZED)
  ========================= */
  const nav = document.querySelector('.main-navigation');

  if (nav) {
    let ticking = false;

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          nav.classList.toggle('is-scrolled', window.scrollY > 0);
          ticking = false;
        });
        ticking = true;
      }
    });
  }


  /* =========================
     INTERSECTION OBSERVER (OPTIMIZED)
  ========================= */
  const sections = document.querySelectorAll('section[id]');
  let currentId = '';

  if (sections.length) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && currentId !== entry.target.id) {
          currentId = entry.target.id;
          history.replaceState(null, null, '#' + currentId);
        }
      });
    }, { threshold: 0.6 });

    sections.forEach((section) => observer.observe(section));
  }

});


/* =========================
   WEBFLOW TAB PARAM (IMPROVED)
========================= */
var Webflow = Webflow || [];
Webflow.push(function () {

  function getParam(name) {
    const params = new URLSearchParams(window.location.search);
    return params.get(name);
  }

  const tabName = getParam('tab');
  if (!tabName) return;

  // Try native click first (faster, no jQuery dependency)
  const tabEl = document.querySelector('.' + tabName);

  if (tabEl) {
    tabEl.click();
  } else if (window.jQuery) {
    // fallback for Webflow tabs if needed
    $('.' + tabName).triggerHandler('click');
  }

});
</script>
</body></html>